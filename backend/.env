APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000

DATABASE_URL=sqlite+aiosqlite:///./controlplane.db
SYNC_DATABASE_URL=sqlite:///./controlplane.db
REDIS_URL=redis://localhost:6379/0

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

ENABLE_DEMO_MODE=true
ENABLE_WEBSOCKETS=true
ENABLE_DEEP_CHECKS=true
ENABLE_LLM_JUDGE=false

DEFAULT_LATENCY_BUDGET_MS=700
DEFAULT_EXPECTED_COST_INR=0.20

PII_ENGINE=regex
LOG_LEVEL=INFO
SECRET_KEY=controlplane-dev-secret-do-not-use-in-production
